<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Container Name" field="name">
    <f:textbox />
  </f:entry>
  <f:entry title="Image" field="image">
    <f:textbox />
  </f:entry>
  <f:entry title="Entrypoint" field="entrypoint">
    <f:textbox />
  </f:entry>
  <f:entry title="Command" field="command">
    <f:textbox />
  </f:entry>
  <f:entry title="Arguments" field="args">
    <f:textbox />
  </f:entry>
  <f:entry title="CPU" field="cpu">
    <f:number />
  </f:entry>
  <f:entry title="Memory (MB)" field="memoryMb">
    <f:number />
  </f:entry>
  <f:entry title="Enable TTY (interactive)" field="ttyEnabled">
    <f:checkbox />
  </f:entry>
  <f:entry>
    <f:repeatableDeleteButton />
  </f:entry>
</j:jelly>
